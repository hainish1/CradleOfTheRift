<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ItemPickupTooltip.uss?fileID=7433441132597879392&amp;guid=e40a49e41eb0c6947b62bfdf6e264063&amp;type=3#ItemPickupTooltip" />
    <ui:VisualElement name="TooltipRoot" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="TooltipBox" picking-mode="Ignore" class="tooltip-box">
            <ui:VisualElement name="TooltipHeader" picking-mode="Ignore" class="tooltip-header">
                <ui:Label name="PickupAction" text="PICK UP" picking-mode="Ignore" class="pickup-action" />
            </ui:VisualElement>
            <ui:VisualElement name="TooltipBody" picking-mode="Ignore" class="tooltip-body">
                <ui:Label name="RarityLabel" text="Rare" picking-mode="Ignore" class="rarity-label" style="font-size: 20px; height: 32px;" />
                <ui:Label name="ItemName" text="ITEM NAME" picking-mode="Ignore" class="item-name" style="font-size: 22px;" />
                <ui:Label name="ItemDescription" text="Item description goes here" picking-mode="Ignore" class="item-description" style="font-size: 25px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
