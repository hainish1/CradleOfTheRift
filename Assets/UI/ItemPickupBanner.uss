
.banner-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    justify-content: flex-end;
    align-items: center;

    /* dont block clicks in the area*/
    picking-mode: ignore;
}

/* Banner card */
.banner-box {
    flex-direction: row;
    align-items: center;

    background-color: rgba(25, 25, 30, 0.92);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(100, 100, 100, 0.8);

    padding: 10px 18px;
    margin-bottom: 60px;          /* distance from bottom of screen */

    min-width: 300px;
    max-width: 480px;

    /* slide-up transition ?? */
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.35s, 0.35s;
    transition-timing-function: ease-out, ease-out;
}

/* hide state - fade out and slide down */
.banner-box--hidden {
    opacity: 0;
    translate: 0 30px;
}

/* Icon */
.banner-icon {
    width: 56px;
    height: 56px;
    min-width: 56px;
    min-height: 56px;
    margin-right: 14px;

    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    background-color: rgba(0, 0, 0, 0.35);

    -unity-background-scale-mode: scale-to-fit;
}

/* Text side */
.banner-text-column {
    flex-direction: column;
    flex-shrink: 1;
}

.banner-rarity {
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    color: rgb(200, 200, 200);
    margin-bottom: 1px;
}

.banner-item-name {
    font-size: 20px;
    font-weight: bold;
    color: white;
    margin-bottom: 4px;
    white-space: normal;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
}

.banner-description {
    font-size: 13px;
    color: rgb(185, 185, 185);
    white-space: normal;
}
