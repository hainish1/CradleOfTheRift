        <engine:Button text="Main Menu" name="mainMenuButton" class="button unityButtonHover" style="scale: 1.5 1.5; position: absolute; top: 560px; left: 123px;" />
        <engine:Button text="Quit Game" name="quitButton" class="button unityButtonHover" style="scale: 1.5 1.5; position: absolute; top: 744px; left: 127px;" />
    </engine:VisualElement>
</engine:UXML>
