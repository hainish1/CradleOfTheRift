.extraction-bar .unity-progress-bar__progress {
    background-color: green;
}

#SpawnerDev {
    position: absolute;  
    bottom: 0px;          /* pin to bottom */
    right: 0px;           /* pin to right */
    width: 291px;         /* desired width */
    height: 216px;        /* desired height */
    
    display: flex;
    flex-direction: column; /* stack children vertically */
    padding: 10px;
    background-color: rgba(0,0,0,0.5); 
}

/* Add spacing between the labels */
#SpawnerDev > Label {
    margin-bottom: 5px;
}

unity-content {
    width: 100%;
    height: 100%;
    position: relative; 
}








#TopLeftHUD {
    position: absolute;
    top: 15px;
    left: 15px;
    flex-direction: column;
}

/* Space between ChestPrompt and Gold */
#TopLeftHUD > * {
    margin-bottom: 8px;
}

#TimerContainer {
    position: absolute;
    top: 10px;        /* distance from top of the screen */
    right: 10px;      /* distance from right of the screen */
    width: auto;      /* or set a fixed width if needed */
}

#TimerContainer > Label {
    color: white;     /* make text visible */
    font-size: 40px;  /* adjust as needed */
}



#InventoryContainer {
    width: 500px;        /* match scroll-view width */
    display: flex;
    flex-direction: column;
    gap: 5px;
}


#ExtractionContainer {
    width: 500px;    /* match inventory width */
    height: 24px;    /* extraction bar height */
    margin-top: 10px;
}


#InventoryGroup {
    position: absolute;
    top: 10px;
    left: 300px;       /* aligns both inventory and extraction bar */
    display: flex;
    flex-direction: column;
    gap: 5px;          /* spacing between inventory and extraction bar */
}

#AbilityBar {
    position: absolute;
    bottom: 20px;      /* moved up 100px from bottom */
    right: 15px;        /* distance from right */
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
}

/* XP HUD */
#XPContainer{
    position: absolute;
    bottom: 50px;
    left: 50px;
    margin-left: -150px;
    width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;

}

#LevelLabel {
    font-size: 20px;
    font-weight: bold;
    color: white;
    margin-bottom: 2px;
}

#LevelUpHint {
    font-size: 14px;
    font-weight: bold;
    color: rgb(255, 220, 50);
    margin-bottom: 2px;
    display: none;
}

#XPLabel {
    font-size: 14px;
    color: rgb(200, 200, 200);
    margin-bottom: 2px;
}

#XPBar {
    width: 100%;
    height: 18px;
}

#XPBar .unity-progress-bar__progress {
    background-color: rgb(80, 180, 255);
}

#XPBar .unity-progress-bar__title {
    display: none;
}