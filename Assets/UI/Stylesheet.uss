#TopLeftHUD {
    position: absolute;
    top: 10px;
    left: 10px;
    flex-direction: row;
    align-items: center;
    padding: 10px 20px 10px 40px;
    height: 100px;
    
    /* Border Image Styling */
    background-image: url('project://database/Assets/Art%20Assets/2D/UI%20assets%202/Timer/Timer_Full_Horizontal_Flip.png?fileID=2800000&amp;guid=216e5e9cb7e4cd94a8c980e15df05700&amp;type=3#Timer_Full_Horizontal_Flip');
    -unity-background-scale-mode: stretch-to-fill;
}

#TimerRoot {
    width: 120px; 
    margin-right: 15px; /* Space between Timer and Scaler */
    margin-left: 10px;
    /* flex-shrink: 0; */ /* Forces timer to not grow */
}

.extraction-bar .unity-progress-bar__progress {
    background-color: green;
}

unity-content {
    width: 100%;
    height: 100%;
    position: relative; 
}

#GoldRoot {
    position: absolute;
    bottom: 120px;
    left: 100px;
}

#XPContainerRoot {
    position: absolute;
    bottom: 95px;
    left: 100px;
}

#HealthBarRoot {
    position: absolute;
    bottom: 60px;
    left: 100px;
}

#InventoryContainer {
    width: 500px;        /* match scroll-view width */
    display: flex;
    flex-direction: column;
    gap: 5px;
}


#ExtractionContainer {
    width: 500px;    /* match inventory width */
    height: 24px;    /* extraction bar height */
    margin-top: 10px;
}


#InventoryGroup {
    position: absolute;
    top: 10px;
    left: 300px;       /* aligns both inventory and extraction bar */
    display: flex;
    flex-direction: column;
    gap: 5px;          /* spacing between inventory and extraction bar */
}

#ChestRoot {
    position: absolute;
    bottom: 55px;
    right: 550px;
}

#AbilityBar {
    position: absolute;
    bottom: 62px;     
    right: 100px;     
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-bottom: 14px; /* make room for key labels (Fixes slight overflow issue) */
}


#SpawnerDevHUDRoot {
    position: absolute;  
    top: 250px;          /* pin to bottom */
    left: 100px;           /* pin to right */
    display: none;
}