.extraction-bar .unity-progress-bar__progress {
    background-color: green;
}

#SpawnerDev {
    position: absolute;  
    bottom: 0px;          /* pin to bottom */
    right: 0px;           /* pin to right */
    width: 291px;         /* desired width */
    height: 216px;        /* desired height */
    
    display: flex;
    flex-direction: column; /* stack children vertically */
    padding: 10px;
    background-color: rgba(0,0,0,0.5); 
}

/* Add spacing between the labels */
#SpawnerDev > Label {
    margin-bottom: 5px;
}

unity-content {
    width: 100%;
    height: 100%;
    position: relative; 
}

#GoldRoot {
    position: absolute;
    bottom: 120px;
    left: 100px;
}

#XPContainerRoot {
    position: absolute;
    bottom: 95px;
    left: 100px;
}

#HealthBarRoot {
    position: absolute;
    bottom: 60px;
    left: 100px;
}

#TimerContainer {
    position: absolute;
    top: 10px;        /* distance from top of the screen */
    right: 10px;      /* distance from right of the screen */
    width: auto;      /* or set a fixed width if needed */
}

#TimerContainer > Label {
    color: white;     /* make text visible */
    font-size: 40px;  /* adjust as needed */
}



#InventoryContainer {
    width: 500px;        /* match scroll-view width */
    display: flex;
    flex-direction: column;
    gap: 5px;
}


#ExtractionContainer {
    width: 500px;    /* match inventory width */
    height: 24px;    /* extraction bar height */
    margin-top: 10px;
}


#InventoryGroup {
    position: absolute;
    top: 10px;
    left: 300px;       /* aligns both inventory and extraction bar */
    display: flex;
    flex-direction: column;
    gap: 5px;          /* spacing between inventory and extraction bar */
}

#ChestRoot {
    position: absolute;
    bottom: 62px;
    right: 550px;
}

#AbilityBar {
    position: absolute;
    bottom: 62px;     
    right: 100px;     
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-bottom: 14px; /* make room for key labels (Fixes slight overflow issue) */
}
