#TopLeftHUD {
    position: absolute;
    top: 10px;
    left: 10px;
    flex-direction: row;
    align-items: center;
    padding: 10px 20px 10px 40px;
    height: 100px;
    
    /* Border Image Styling */
    background-image: url('project://database/Assets/Art%20Assets/2D/UI%20assets%202/Timer/Timer_Full_Horizontal_Flip.png?fileID=2800000&amp;guid=216e5e9cb7e4cd94a8c980e15df05700&amp;type=3#Timer_Full_Horizontal_Flip');
    -unity-background-scale-mode: stretch-to-fill;
}

#TimerRoot {
    width: 120px; 
    margin-right: 15px; /* Space between Timer and Scaler */
    margin-left: 10px;
    /* flex-shrink: 0; */ /* Forces timer to not grow */
}


unity-content {
    width: 100%;
    height: 100%;
    position: relative; 
}

#GoldRoot {
    position: absolute;
    bottom: 120px;
    left: 100px;
}

#XPContainerRoot {
    position: absolute;
    bottom: 95px;
    left: 100px;
}

#HealthBarRoot {
    position: absolute;
    bottom: 60px;
    left: 100px;
}

#BossHealthRoot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}


#InventoryContainer {
    width: 500px;        /* match scroll-view width */
    display: flex;
    flex-direction: column;
    gap: 5px;
}

#ObjectivesPanelRoot {
    position: absolute;
    top: 124px;
    right: 40px;
}


#InventoryGroup {
    position: absolute;
    top: 10px;
    left: 300px;       /* aligns both inventory and extraction bar */
    display: flex;
    flex-direction: column;
    gap: 5px;          /* spacing between inventory and extraction bar */
}

#PassiveInventoryStripRoot {
    position: absolute;
    top: 72px;
    left: 280px;
    right: 360px;
    height: 76px;
    display: none;
}

#PassiveInventoryPanel {
    height: 100%;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

#PassiveInventoryContent {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.passive-inventory-slot {
    position: relative;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.passive-inventory-icon {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.passive-inventory-count {
    position: absolute;
    right: 2px;
    bottom: 0;
    min-width: 14px;
    padding-left: 3px;
    padding-right: 3px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0.72);
    -unity-text-align: middle-center;
}

#ChestRoot {
    position: absolute;
    bottom: 55px;
    right: 550px;
}

#AbilityBar {
    position: absolute;
    bottom: 62px;     
    right: 100px;     
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-bottom: 14px; /* make room for key labels (Fixes slight overflow issue) */
}


#SpawnerDevHUDRoot {
    position: absolute;  
    top: 250px;          /* pin to bottom */
    left: 100px;           /* pin to right */
    display: none;
}

/* Center Level Up Hint Styling */
#CenterLevelUpHint {
    position: absolute;
    top: 45%;
    left: 50%;
    translate: -50% -50%; /* Perfectly centers the element */
    
    display: none;
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF; /* Subdued grayish-white */
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    

    /* 1. TEXT PROTECTION: Outline ensures readability on bright scenes */
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);

    /* 2. BACKGROUND: Subtle horizontal 'wash' instead of a box */
    background-color: rgba(0, 0, 0, 0.4);
    
    /* 3. BRAKETS: Framing the text */
    border-left-width: 3px;
    border-right-width: 3px;
    border-left-color: rgb(80, 180, 255);
    border-right-color: rgb(80, 180, 255);
    
    /* 4. UNDERLINE: Thin accent to ground the text */
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.3);




    padding: 4px 14px 2px 14px;
    border-radius: 0;

    /* fade-in base state */
    opacity: 0;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.4s, 0.4s;
    transition-timing-function: ease-in-out, ease-in-out;
}

#CenterLevelUpHint.hint-visible {
    opacity: 1;
    scale: 1 1;
}

#CenterLevelUpHint.hint-pulse-dim {
    opacity: 0.45;
    scale: 1.1 1.1;
    transition-duration: 0.9s, 0.9s;
}
