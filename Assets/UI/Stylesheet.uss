#TopLeftHUD {
    position: absolute;
    top: 10px;
    left: 10px;
    flex-direction: row;
    align-items: center;
    padding: 10px 20px 10px 40px;
    height: 100px;
    
    /* Border Image Styling */
    background-image: url('project://database/Assets/Art%20Assets/2D/UI%20assets%202/Timer/Timer_Full_Horizontal_Flip.png?fileID=2800000&amp;guid=216e5e9cb7e4cd94a8c980e15df05700&amp;type=3#Timer_Full_Horizontal_Flip');
    -unity-background-scale-mode: stretch-to-fill;
}

#TimerRoot {
    width: 120px; 
    margin-right: 15px; /* Space between Timer and Scaler */
    margin-left: 10px;
    /* flex-shrink: 0; */ /* Forces timer to not grow */
}


unity-content {
    width: 100%;
    height: 100%;
    position: relative; 
}

#GoldRoot {
    position: absolute;
    bottom: 120px;
    left: 100px;
}

#XPContainerRoot {
    position: absolute;
    bottom: 95px;
    left: 100px;
}

#HealthBarRoot {
    position: absolute;
    bottom: 60px;
    left: 100px;
}

#InventoryContainer {
    width: 500px;        /* match scroll-view width */
    display: flex;
    flex-direction: column;
    gap: 5px;
}




#InventoryGroup {
    position: absolute;
    top: 10px;
    left: 300px;       /* aligns both inventory and extraction bar */
    display: flex;
    flex-direction: column;
    gap: 5px;          /* spacing between inventory and extraction bar */
}

#ChestRoot {
    position: absolute;
    bottom: 55px;
    right: 550px;
}

#AbilityBar {
    position: absolute;
    bottom: 62px;     
    right: 100px;     
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-bottom: 14px; /* make room for key labels (Fixes slight overflow issue) */
}


#SpawnerDevHUDRoot {
    position: absolute;  
    top: 250px;          /* pin to bottom */
    left: 100px;           /* pin to right */
    display: none;
}

/* Center Level Up Hint Styling */
#CenterLevelUpHint {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%; /* Perfectly centers the element */
    margin-top: 100px; /* Nudges it below the center crosshair */
    
    display: none;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(200, 200, 200, 0.9); /* Subdued grayish-white */
    -unity-text-align: middle-center;
    
    background-color: rgba(40, 40, 40, 0.6); /* Semi-transparent dark gray */
    border-color: rgba(120, 120, 120, 0.5);
    border-width: 1px;
    border-radius: 10px;
    padding: 3px 12px;

    /* fade-in base state */
    opacity: 0;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.4s, 0.4s;
    transition-timing-function: ease-in-out, ease-in-out;
}

#CenterLevelUpHint.hint-visible {
    opacity: 1;
    scale: 1 1;
}

#CenterLevelUpHint.hint-pulse-dim {
    opacity: 0.45;
    scale: 1.05 1.05;
    transition-duration: 0.9s, 0.9s;
}