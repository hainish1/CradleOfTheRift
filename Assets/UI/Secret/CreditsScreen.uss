/* ── Root ──────────────────────────────────────── */
.credits-root {
    flex-grow: 1;
    background-color: rgb(10, 10, 18);
    overflow: hidden;
}

/* ── ScrollView fills all space above skip button ─ */
.credits-scroll {
    flex-grow: 1;
}

/* Hide the internal content container padding */
.credits-scroll > #unity-content-container {
    padding: 0;
}

/* ── Credits content column ─────────────────────── */
.credits-container {
    align-items: center;
    padding-bottom: 80px;
    /* padding-top is set in C# once panel height is known */
}

/* ── Sections ───────────────────────────────────── */
.section {
    align-items: center;
    margin-bottom: 48px;
}

.divider {
    width: 40px;
    height: 1px;
    background-color: rgb(58, 53, 96);
    margin-bottom: 48px;
}

.end-spacer {
    height: 120px;
}

/* ── Typography ─────────────────────────────────── */
.game-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.game-subtitle {
    font-size: 12px;
    color: rgb(112, 112, 160);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 0;
}

.role-title {
    font-size: 11px;
    color: rgb(123, 111, 240);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.name {
    font-size: 20px;
    color: rgb(232, 230, 240);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.name.lead {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.special-thanks {
    font-size: 14px;
    color: rgb(112, 112, 160);
    white-space: normal;
    max-width: 400px;
    -unity-text-align: middle-center;
}

/* ── Fade overlays ──────────────────────────────── */
.fade-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100px;
    /* Unity USS doesn't support CSS gradients — handled via C# painter */
}

.fade-bottom {
    position: absolute;
    bottom: 44px;
    left: 0;
    right: 0;
    height: 100px;
}

/* ── Skip button ────────────────────────────────── */
.skip-button {
    position: absolute;
    bottom: 16px;
    right: 24px;
    background-color: rgb(30, 28, 48);
    color: rgb(176, 174, 208);
    border-color: rgb(58, 53, 96);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    cursor: link;
}

.skip-button:hover {
    background-color: rgb(42, 40, 80);
    color: rgb(224, 222, 255);
}