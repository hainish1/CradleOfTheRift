/* AbilitySlot.uss
   The icon, overlay and border are all drawn by DiamondAbilityElement.
   This sheet only handles layout and text labels.                        */

#AbilitySlotContainer {
    width: 90px;
    height: 132px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin-left: 10px;
    margin-right: 10px;
}

/* Size the custom diamond element. Keep it square so the diamond is symmetric. */
DiamondAbilityElement,
#DiamondSlot {
    width: 90px;
    height: 90px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 2px 0;

    /* Visual properties for DiamondAbilityElement */
    --border-color: rgb(168, 144, 96);

    /* --border-color: rgb(130, 100, 60); */



    --border-width: 2;
    --overlay-color: rgba(0, 0, 0, 0.6);
}

#KeyLabel {
    font-size: 14px;
    color: white;
    margin-top: 2px;
    -unity-text-align: middle-center;
}

#ChargeLabel {
    font-size: 14px;
    color: white;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
    height: 18px;   
}

#ChargeLabel.hidden {
    visibility: hidden;
}

#CooldownLabel {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-text-align: middle-center;
    color: white;
    -unity-font-style: bold;
    font-size: 20px;
}