#DifficultyContainer {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 300px;
    background-color: rgba(20, 20, 20, 0.85); /* Dark, slightly transparent background */
    padding: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: rgb(60, 60, 60);
}

#DifficultyLabel {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    letter-spacing: 2px;
}

#DifficultyBarBackground {
    width: 100%;
    height: 18px;
    background-color: rgb(40, 40, 40); /* Empty track color */
    border-radius: 4px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgb(20, 20, 20);
}

#DifficultyBarFill {
    height: 100%;
    width: 0%; /* Initial state, your C# script overrides this */
    background-color: rgb(220, 180, 50); /* A classic action-game gold/yellow */
    
    /* This makes the bar fill smoothly instead of instantly snapping */
    transition-property: width;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}