#DifficultyContainer {
    width: 260px;
    height: 28px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.65);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
}

#DifficultyStrip {
    flex-direction: row;
    height: 100%;
    flex-grow: 1;
    transition-property: translate;
    transition-duration: 0s;
    transition-timing-function: ease-out;
}

.difficulty-segment {
    height: 100%;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.difficulty-text {
    color: rgba(255, 255, 255, 0.9);
    -unity-font-style: bold;
    font-size: 11px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    opacity: 0.85;
}

#DifficultyMarker {
    position: absolute;
    left: 50%;
    height: 100%;
    width: 2px;
    background-color: rgb(255, 255, 255);
    translate: -50% 0;
}

#MarkerArrow {
    position: absolute;
    bottom: -4px;
    left: -4px;
    width: 10px;
    height: 10px;
    background-color: rgb(255, 255, 255);
    rotate: 45deg;
    border-radius: 2px;
}