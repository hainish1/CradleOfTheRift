<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Secret/CreditsScreen.uss?fileID=7433441132597879392&amp;guid=1cce08f07173c23468f067fedab1a18d&amp;type=3#CreditsScreen" />
    <ui:VisualElement name="credits-root" class="credits-root">
        <ui:VisualElement name="fade-top" class="fade-top" />
        <ui:VisualElement name="fade-bottom" class="fade-bottom" />
        <ui:ScrollView name="credits-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="credits-scroll">
            <ui:VisualElement name="credits-container" class="credits-container">
                <ui:VisualElement class="section">
                    <ui:Label text="CapyCo presents" class="studio-badge" />
                    <ui:Label text="Cradle of The Rift" class="game-title" />
                    <ui:Label text="A STUDENT GAME PROJECT · 2025-2026" class="game-subtitle" />
                </ui:VisualElement>
                <ui:VisualElement class="rune-divider">
                    <ui:VisualElement class="rune-line" />
                    <ui:VisualElement class="rune-gem" />
                    <ui:VisualElement class="rune-line" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="PRODUCERS" class="role-title" />
                    <ui:Label text="Yahir Carrillo" class="name lead" />
                    <ui:Label text="Kaylee Lai" class="name" />
                </ui:VisualElement>
                <ui:VisualElement class="rune-divider">
                    <ui:VisualElement class="rune-line" />
                    <ui:VisualElement class="rune-gem" />
                    <ui:VisualElement class="rune-line" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="DESIGNERS" class="role-title" />
                    <ui:Label text="Noah Lemon" class="name" />
                    <ui:Label text="Li Shen" class="name" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="2D ARTISTS" class="role-title" />
                    <ui:Label text="Bodee Butterworth" class="name" />
                    <ui:Label text="Ray Kimber" class="name" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="3D ARTISTS" class="role-title" />
                    <ui:Label text="Taylors Hamilton" class="name" />
                    <ui:Label text="Carson Millar" class="name" />
                    <ui:Label text="Connor Ostermann" class="name" />
                    <ui:Label text="Chun Hin Wong" class="name" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="AUDIO" class="role-title" />
                    <ui:Label text="Marshall Pease" class="name" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="ENGINEERING" class="role-title" />
                    <ui:Label text="Hainish Dharmendra Acharya" class="name" />
                    <ui:Label text="Jared Hildt" class="name" />
                    <ui:Label text="Jiedi Mo" class="name" />
                    <ui:Label text="Samuel Rigby" class="name" />
                    <ui:Label text="Kevin Soto-Miranda" class="name" />
                </ui:VisualElement>
                <ui:VisualElement class="rune-divider">
                    <ui:VisualElement class="rune-line" />
                    <ui:VisualElement class="rune-gem" />
                    <ui:VisualElement class="rune-line" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="SPECIAL THANKS" class="role-title" />
                    <ui:Label text="To our friends, family, and everyone who played the demo." class="name special-thanks" />
                    <ui:VisualElement class="collab-block">
                        <ui:Label text="Punk Plush Panic on Steam" class="name" />
                        <ui:Label text="Developed by Gecko Gecko Gecko" class="collab-developer" />
                        <ui:Label text="Art assets used with permission for Easter egg content exchange." class="collab-note" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="THE UI ARCHITECT" class="role-title" />
                    <ui:Label text="Kevin Soto-Miranda - Did everything you just clicked on, and then wrote this line because nobody else would." class="name special-thanks" />
                    <ui:Label text="DELETE THIS BTW" class="name special-thanks" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:Label text="TYPOGRAPHY" class="role-title" />
                    <ui:Label text="Cocobiker by Zetafonts" class="name" />
                    <ui:Label text="Designed by Cosimo Lorenzo Pancini" class="special-thanks" />
                </ui:VisualElement>
                <ui:VisualElement class="section">
                    <ui:VisualElement class="seal-logo" />
                </ui:VisualElement>
                <ui:VisualElement class="end-spacer" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement name="tree-left" class="tree tree-left" />
        <ui:VisualElement name="tree-right" class="tree tree-right" />
        <ui:Button name="skip-button" text="Skip >" class="skip-button" />
    </ui:VisualElement>
</ui:UXML>
