    <engine:VisualElement name="compass-root" picking-mode="Ignore" class="compass-root">
        <engine:VisualElement name="compass-mask" class="compass-mask" style="background-color: rgba(0, 0, 0, 0); scale: 1.2 1.2; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/Art%20Assets/2D/UI%20assets%202/Compass/Compass_Full.png?fileID=2800000&amp;guid=21a9c61980a544c5e93a99f6109edbec&amp;type=3#Compass_Full&quot;); width: 1000px; height: 100px; top: 1px; position: absolute; left: 460px;">
            <engine:VisualElement name="icon-container" class="icon-container" style="background-image: url(&quot;project://database/Assets/Art%20Assets/2D/UI%20assets%202/Compass/Compass_Background_Gradient.png?fileID=2800000&amp;guid=831a30a285aaf41588df35f061b84b7f&amp;type=3#Compass_Background_Gradient&quot;); scale: 1 1; flex-grow: 0; width: 1013px; height: 100%; top: -1px; left: -11px; -unity-background-image-tint-color: rgb(0, 0, 0); -unity-background-scale-mode: stretch-to-fill;" />
            <engine:VisualElement name="center-notch" class="center-notch" style="width: 5px; height: 25px;" />
            <engine:VisualElement name="icon-container" class="icon-container" style="background-image: url(&quot;project://database/Assets/Art%20Assets/2D/UI%20assets%202/Compass/Compass_Background_Gradient.png?fileID=2800000&amp;guid=831a30a285aaf41588df35f061b84b7f&amp;type=3#Compass_Background_Gradient&quot;); scale: 1 1; flex-grow: 0; width: 1013px; height: 100%; top: -1px; left: -11px; -unity-background-image-tint-color: rgb(0, 0, 0); -unity-background-scale-mode: stretch-to-fill; background-size: 90% 90%;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
