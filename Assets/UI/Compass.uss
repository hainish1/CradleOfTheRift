/* Main positioning on the HUD */
.compass-root {
    width: 100%;
    height: 120px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 20px;
}

/* The window that crops the icons */
.compass-mask {
    width: 600px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    overflow: hidden; /* Crucial: hides icons outside this box */
}

.icon-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* Base style for all markers */
.marker {
    position: absolute;
    width: 32px;
    height: 32px;
    top: 9px;
    /* Temporary Red Square for testing */
    background-color: red; 
    /* Force this to render on top */
    z-index: 10; 
}


/* Specific icon textures */
.icon-cave {
    background-image: url('Assets/Scripts/UI/cave.png'); 
    -unity-background-scale-mode: scale-to-fit;
}

.icon-extraction {
    background-image: url('Assets/Scripts/UI/cave.png'); 
    -unity-background-scale-mode: scale-to-fit;
}

/* The fixed center pointer */
.center-notch {
    width: 2px;
    height: 15px;
    background-color: #FFFFFF;
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
} 