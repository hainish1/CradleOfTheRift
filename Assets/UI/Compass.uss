.compass-root {
    width: 100%;
    height: 120px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 20px;
}

.compass-mask {
    width: 600px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    overflow: hidden;
}

.icon-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

.marker {
    position: absolute;
    width: 32px;
    height: 32px;
    top: 9px;
    background-color: red;
    z-index: 10;
}

.icon-cave {
    background-image: url("project://database/Assets/Scripts/UI/cave.png?fileID=2800000&guid=7bc6342d20782164d86062bc700ac78a&type=3#cave");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.icon-extraction {
    background-image: url("project://database/Assets/Scripts/UI/cave.png?fileID=2800000&guid=7bc6342d20782164d86062bc700ac78a&type=3#cave");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

.center-notch {
    width: 2px;
    height: 15px;
    background-color: rgb(255, 255, 255);
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% 0;
}
