#XPContainer {
    position: absolute;
    bottom: 50px;
    left: 50px;
    width: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

#LevelLabel {
    font-size: 20px;
    font-weight: bold;
    color: white;
    margin-bottom: 2px;
}

#LevelUpHint {
    font-size: 14px;
    font-weight: bold;
    color: rgb(255, 220, 50);
    margin-bottom: 2px;
    display: none;
}

#XPLabel {
    font-size: 14px;
    color: rgb(200, 200, 200);
    margin-bottom: 2px;
}

#XPBar {
    width: 100%;
    height: 18px;
}

#XPBar .unity-progress-bar__progress {
    background-color: rgb(80, 180, 255);
}

#XPBar .unity-progress-bar__title {
    display: none;
}