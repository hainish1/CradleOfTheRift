#XPContainer {
    width: 340px;
    flex-direction: column;
    align-items: stretch;
}

/* Row: [LevelLabel] [XPBar] [XPLabel] */
#XPRow {
    flex-direction: row;
    align-items: center;
    height: 22px;
    margin-top: 4px;
}

#LevelLabel {
    width: 52px;
    height: 22px;
    background-color: rgba(80, 180, 255, 0.15);
    border-color: rgba(80, 180, 255, 0.50);
    border-width: 1px;
    border-radius: 4px;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(80, 180, 255);
    padding: 0;
    margin-right: 8px;
    flex-shrink: 0;
}

#XPBar {
    flex-grow: 1;
    align-self: center;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0.50);
    border-color: rgba(80, 180, 255, 0.25);
    border-width: 1px;
    border-radius: 3px;
}

#XPBar .unity-progress-bar__title {
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#XPBar .unity-progress-bar__background {
    background-color: transparent;
    border-width: 0;
}

#XPBar .unity-progress-bar__progress {
    background-color: rgba(80, 180, 255, 0.85);
}

#LevelUpHint {
    display: none;
    align-self: center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 220, 50);
    -unity-text-align: middle-center;

    /* pill shape */
    background-color: rgba(30, 20, 0, 0.72);
    border-color: rgba(255, 200, 40, 0.75);
    border-width: 1px;
    border-radius: 10px;
    padding: 2px 10px;
    margin-bottom: 3px;

    /* fade-in base state */
    opacity: 0;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.4s, 0.4s;
    transition-timing-function: ease-in-out, ease-in-out;
}

/* applied by C# right after display is set to Flex — triggers fade-in */
#LevelUpHint.hint-visible {
    opacity: 1;
    scale: 1 1;
}

/* pulse: dims and grows slightly to create a breathing effect */
#LevelUpHint.hint-pulse-dim {
    opacity: 0.45;
    scale: 1.05 1.05;
    transition-duration: 0.9s, 0.9s;
}
