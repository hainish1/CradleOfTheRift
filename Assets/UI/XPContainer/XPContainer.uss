#XPContainer {
    width: 340px;
    flex-direction: column;
    align-items: stretch;
}

/* Row: [LevelLabel] [XPBar] [XPLabel] */
#XPRow {
    flex-direction: row;
    align-items: center;
    height: 22px;
    margin-bottom: 5px;
}

#LevelLabel {
    width: 52px;
    height: 22px;
    background-color: rgba(80, 180, 255, 0.15);
    border-color: rgba(80, 180, 255, 0.50);
    border-width: 1px;
    border-radius: 4px;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(80, 180, 255);
    padding: 0;
    margin-right: 8px;
    flex-shrink: 0;
}

#XPBar {
    flex-grow: 1;
    align-self: center;
    margin: 0;
    /* margin-right: 8px; */
    padding: 0;
    background-color: rgba(0, 0, 0, 0.50);
    border-color: rgba(80, 180, 255, 0.25);
    border-width: 1px;
    border-radius: 3px;
}

#XPBar .unity-progress-bar__title {
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

#XPBar .unity-progress-bar__background {
    background-color: transparent;
    border-width: 0;
}

#XPBar .unity-progress-bar__progress {
    background-color: rgba(80, 180, 255, 0.85);
}

#LevelUpHint {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 220, 50);
    -unity-text-align: middle-center;
    display: none;
    margin: 0;
    padding: 0;
}
