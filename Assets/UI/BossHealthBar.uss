#BossHealthContainer {
    position: absolute;
    top: 20px;
    left: 25%;
    width: 50%;
    height: 30px;
    display: none;
}

#BossHealthBar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

#BossDamageBar {
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

#BossHealthBar .unity-progress-bar__background,
#BossDamageBar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
    border-radius: 4px;
}

#BossHealthBar .unity-progress-bar__progress {
    background-color: rgba(190, 42, 42, 0.95);
    border-radius: 4px;
}

#BossDamageBar .unity-progress-bar__progress {
    background-color: rgba(255, 210, 120, 0.85);
    border-radius: 4px;
}

#BossHealthBar .unity-progress-bar__title {
    color: rgba(255, 255, 255, 0.95);
    font-size: 14px;
    -unity-font-style: bold;
}

#BossDamageBar .unity-progress-bar__title {
    color: rgba(0, 0, 0, 0);
}
