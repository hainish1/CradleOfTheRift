
#HealthContainer {
    position: absolute;
    bottom: 15px;      /* distance from bottom; adjust so it’s above inventory */
    left: 50%;         /* align with left edge of screen */
    margin-left: -150px;
    width: 300px;       /* health bar width */
    height: 25px;       /* health bar height */
}

#HealthBar {
    width: 100%;        /* fill the container */
    height: 100%;
    margin: 0;
}

#HealthBar .unity-progress-bar__title {
    color: white;
    font-size: 14px;
}

#HealthBar .unity-progress-bar__progress {
    background-color: red;
}