#HealthContainer {
    width: 340px;
    height: 26px;
}

#HealthBar,
#DamageBar {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
}

#HealthBar .unity-progress-bar__background,
#DamageBar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
    border-radius: 3px;
}

/* Health fill: clean green  */
#HealthBar .unity-progress-bar__progress {
    background-color: rgba(80, 200, 100, 0.90);
    border-radius: 3px;
}

/* Damage fill: red ghost */
#DamageBar .unity-progress-bar__progress {
    background-color: rgba(210, 50, 50, 0.85);
    border-radius: 3px;
}

#HealthBar .unity-progress-bar__title {
    color: rgba(255, 255, 255, 0.90);
    font-size: 14px;
    -unity-font-style: bold;
}

/* Hide the label on the damage bar */
#DamageBar .unity-progress-bar__title {
    color: rgba(0, 0, 0, 0);
}
