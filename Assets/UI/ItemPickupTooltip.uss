/* Tooltip container */
.tooltip-box {
    position: absolute;
    align-items: flex-start;
    flex-direction: column;
    min-width: 220px;
    max-width: 320px;
}

/* Header row- "PICK UP" */
.tooltip-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    gap: 6px;
}

.pickup-hint {
    font-size: 16px;
    font-weight: bold;
    color: white;
    background-color: rgba(50, 50, 50, 0.95);
    border-radius: 4px;
    padding: 2px 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-center;
}

.pickup-action {
    font-size: 18px;
    font-weight: bold;
    color: white;
    -unity-text-align: middle-left;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}

/* Body- name, rarity, item description*/
.tooltip-body {
    background-color: rgba(40, 40, 40, 0.92);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(100, 100, 100, 0.8);
    padding: 10px 14px;
}

.rarity-label {
    font-size: 13px;
    color: rgb(200, 200, 200);
    margin-bottom: 2px;
}

.item-name {
    font-size: 20px;
    font-weight: bold;
    color: white;
    margin-bottom: 6px;
    white-space: normal;
}

.item-description {
    font-size: 14px;
    color: rgb(190, 190, 190);
    white-space: normal;
}
