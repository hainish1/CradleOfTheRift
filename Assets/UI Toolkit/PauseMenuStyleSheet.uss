.button {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    justify-content: flex-end;
    width: 450px;
    height: 100px;
    align-content: auto;
    align-items: center;
    align-self: center;
    background-image: none;
    border-left-color: rgba(0, 0, 0, 0.47);
    border-right-color: rgba(0, 0, 0, 0.47);
    border-top-color: rgba(0, 0, 0, 0.47);
    border-bottom-color: rgba(0, 0, 0, 0.47);
    font-size: 80px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/CocobikerUltralight-Egx4-Font.ttf?fileID=12800000&guid=c1ec8293e05204e50923774ef50aedf1&type=3#CocobikerUltralight-Egx4-Font");
    background-color: rgba(21, 7, 34, 0.94);
    color: rgb(255, 255, 255);
}

.unityButtonHover:hover {
    background-color: rgba(255, 255, 255, 0);
    color: rgb(245, 240, 230);
    transition-property: scale, -unity-background-image-tint-color;
    scale: 1.1 1.1;
    transition-duration: 0.25s, 0.25s;
    background-image: url("project://database/Assets/Art%20Assets/2D/UI%20assets%202/Game_Over_Select_Glow.png?fileID=2800000&guid=ff0774dcf9244496ab0ec1c96b51e8cc&type=3#Game_Over_Select_Glow");
    transition-timing-function: ease, ease-in-elastic;
}

.header {
    font-size: 200px;
    -unity-text-align: upper-center;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    justify-content: flex-start;
    background-position-x: center 0;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/CocobikerLight-aGnx-Font.ttf?fileID=12800000&guid=353234806b51d43e58d9161acf6d5b78&type=3#CocobikerLight-aGnx-Font");
}

.h1 {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/CocobikerUltralight-Egx4-Font.ttf?fileID=12800000&guid=c1ec8293e05204e50923774ef50aedf1&type=3#CocobikerUltralight-Egx4-Font");
    font-size: 100px;
    color: rgb(255, 255, 255);
    translate: 25px 0;
}

.h2 {
    background-color: rgba(255, 255, 255, 0);
    font-size: 90px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/CocobikerUltralight-Egx4-Font.ttf?fileID=12800000&guid=c1ec8293e05204e50923774ef50aedf1&type=3#CocobikerUltralight-Egx4-Font");
    color: rgb(255, 255, 255);
}

.listBox {
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgb(255, 244, 244);
    opacity: 1;
}

.descBox {
}

.item {
    -unity-font-definition: url("project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&guid=74a5091d8707f334b9a5c31ef71a64ba&type=3#PerfectDOSVGA437");
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Art%20Assets/2D/UI%20assets%202/Inventory/Inventory_Full.png?fileID=2800000&guid=892425e4b80b84198a7f684623b4dce5&type=3#Inventory_Full");
}

.description {
    font-size: 60px;
    color: rgb(255, 255, 255);
    padding-left: 30px; 
    padding-right: 30px;
    padding-top: 10px;
}

.item:hover {
    transition-duration: 0.15s;
    transition-property: scale;
    scale: 1.4 1.4;
    background-image: url("project://database/Assets/Art%20Assets/2D/UI%20assets%202/Inventory/Inventory_Full_Select.png?fileID=2800000&guid=27468393484734e0d8edb610f0eaecf5&type=3#Inventory_Full_Select");
}

.Background {
    flex-grow: 1;
    background-color: rgba(14, 0, 29, 0.94);
    width: 1920px;
    height: 1080px;
}

#DescriptionScroll {
    padding-right: 20px;
}

.unity-scroller__low-button {
    display: none;
}

.unity-scroller__high-button {
    display: none;
}

.unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 0;
    border-radius: 4px;
    width: 8px;
}

.unity-base-slider__dragger {
    background-color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 4px;
    width: 8px;
    transition-duration: 0.2s;
}

.unity-base-slider__dragger:hover {
    background-color: rgb(228, 0, 255);
    scale: 1.2 1;
}

.unity-scroller {
    width: 12px;
    background-color: transparent;
    align-items: center;
}

/* Base Background Layer */
.bg-layer-base {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Art%20Assets/2D/UI/MainMenu/BackgroundStart.jpg?fileID=2800000&amp;guid=bdc19787db477462eaf6c01afdd7b062&amp;type=3#BackgroundStart");
    -unity-background-scale-mode: scale-and-crop;
}

/* Midground Layer (Second Image) */
.bg-layer-mid {
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Art%20Assets/2D/UI/MainMenu/FairyStart.png?fileID=2800000&amp;guid=703e5081abe9245048e31ad968d5a794&amp;type=3#FairyStart");
    -unity-background-scale-mode: scale-and-crop;
    /* Optional: If you need to force it behind buttons regardless of UXML order */
    /* z-index: -1; */ 
}