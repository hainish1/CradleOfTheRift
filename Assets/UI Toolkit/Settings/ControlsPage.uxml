<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/SettingsStyleSheet.uss?fileID=7433441132597879392&amp;guid=4e331d6e341bfd245aadb0e434e7894e&amp;type=3#SettingsStyleSheet" />
    
    <engine:VisualElement name="PageControls" class="settings-page" style="display: none;">

<!-- Action rows are generated here at runtime by ControlsPageController -->
        <engine:ScrollView name="ControlsScrollView" mode="Vertical" style="flex-grow: 1;" />

        <!-- Rebind Modal -->
        <engine:VisualElement name="RebindModal" class="modal-overlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <engine:VisualElement class="modal-box" style="min-width: 800px;">
                <engine:Label name="RebindModalTitle" text="Rebinding" class="modal-title" />
                <engine:Label name="RebindModalBody" text="Press any key..." class="modal-body" />
                <engine:VisualElement class="modal-buttons">
                    <engine:Button name="RebindCancelButton" text="Cancel" class="button modal-button unityButtonHover" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
