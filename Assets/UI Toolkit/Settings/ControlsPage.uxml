<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/SettingsStyleSheet.uss?fileID=7433441132597879392&amp;guid=4e331d6e341bfd245aadb0e434e7894e&amp;type=3#SettingsStyleSheet" />
    <engine:VisualElement name="PageControls" class="settings-page" style="display: none;">

<!-- Scrollable list of rebindable actions -->
        <engine:ScrollView name="ControlsScrollView"
                           mode="Vertical"
                           style="flex-grow: 1;">

            <!-- ── Movement ── -->
            <engine:Label text="Movement" class="controls-section-header" />

            <engine:VisualElement name="Row_MoveUp" class="settings-row controls-row">
                <engine:Label text="Move Up" class="settings-label" />
                <engine:Button name="Bind_MoveUp" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <engine:VisualElement name="Row_MoveDown" class="settings-row controls-row">
                <engine:Label text="Move Down" class="settings-label" />
                <engine:Button name="Bind_MoveDown" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <engine:VisualElement name="Row_MoveLeft" class="settings-row controls-row">
                <engine:Label text="Move Left" class="settings-label" />
                <engine:Button name="Bind_MoveLeft" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <engine:VisualElement name="Row_MoveRight" class="settings-row controls-row">
                <engine:Label text="Move Right" class="settings-label" />
                <engine:Button name="Bind_MoveRight" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <!-- ── Actions ── -->
            <engine:Label text="Actions" class="controls-section-header" />

            <engine:VisualElement name="Row_Jump" class="settings-row controls-row">
                <engine:Label text="Jump" class="settings-label" />
                <engine:Button name="Bind_Jump" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <engine:VisualElement name="Row_Interact" class="settings-row controls-row">
                <engine:Label text="Interact" class="settings-label" />
                <engine:Button name="Bind_Interact" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <engine:VisualElement name="Row_Attack" class="settings-row controls-row">
                <engine:Label text="Attack" class="settings-label" />
                <engine:Button name="Bind_Attack" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <engine:VisualElement name="Row_Dodge" class="settings-row controls-row">
                <engine:Label text="Dodge" class="settings-label" />
                <engine:Button name="Bind_Dodge" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <!-- ── UI / System ── -->
            <engine:Label text="System" class="controls-section-header" />

            <engine:VisualElement name="Row_Pause" class="settings-row controls-row">
                <engine:Label text="Pause" class="settings-label" />
                <engine:Button name="Bind_Pause" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

            <engine:VisualElement name="Row_Sprint" class="settings-row controls-row">
                <engine:Label text="Sprint" class="settings-label" />
                <engine:Button name="Bind_Sprint" class="button controls-bind-button unityButtonHover" />
            </engine:VisualElement>

        </engine:ScrollView>

        <!-- Reset to defaults button -->
        <!-- <engine:Button name="ButtonResetControls"
                       text="Reset to Defaults"
                       class="button controls-reset-button unityButtonHover"
                       style="align-self: flex-end; margin-top: 20px; width: 420px; font-size: 44px; height: 80px;" /> -->

        <!-- ── Rebind Modal ── -->
        <engine:VisualElement name="RebindModal" class="modal-overlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
            <engine:VisualElement class="modal-box" style="min-width: 800px;">
                <engine:Label name="RebindModalTitle" text="Rebinding" class="modal-title" />
                <engine:Label name="RebindModalBody"
                              text="Press any key..."
                              class="modal-body" />
                <engine:VisualElement class="modal-buttons">
                    <engine:Button name="RebindCancelButton"
                                   text="Cancel"
                                   class="button modal-button unityButtonHover" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
